[gd_scene load_steps=3 format=3]
[ext_resource type="Script" path="res://scenes/piece_draft/piece_addition_screen.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/icons/actions/confirm.png" id="2"]

[node name="PieceAdditionScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="Center"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 430)
layout_mode = 2
theme_type_variation = &"ElevatedPanel"

[node name="Layout" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/Panel/Layout"]
layout_mode = 2
theme_type_variation = &"HeadingLarge"
text = "ADD A BLOCK"
horizontal_alignment = 1

[node name="Prompt" type="Label" parent="Center/Panel/Layout"]
layout_mode = 2
text = "Choose a Block to add to this run's Block pile."
horizontal_alignment = 1
autowrap_mode = 2

[node name="CandidateScroll" type="ScrollContainer" parent="Center/Panel/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 1
vertical_scroll_mode = 0

[node name="Candidates" type="HBoxContainer" parent="Center/Panel/Layout/CandidateScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
size_flags_horizontal = 3
alignment = 1
theme_override_constants/separation = 12

[node name="Pool" type="Label" parent="Center/Panel/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedText"
text = "CURRENT BLOCK PILE"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Confirm" type="Button" parent="Center/Panel/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
tooltip_text = "Add Selected Block"
icon = ExtResource("2")
expand_icon = true
icon_max_width = 40
icon_alignment = 1
