pieces = Array[ExtResource("7_7p1h7")]([ExtResource("10_domino"), ExtResource("11_tet_l")])

[sub_resource type="Resource" id="ChoiceTarget"]
script = ExtResource("3")
target_key = 8
padding = 5.0

[sub_resource type="Resource" id="ChoiceStep"]
script = ExtResource("2")
step_type = 6
title = "Select a drawn Block"
body = "Choose the highlighted drawn piece. Its Block becomes your placement preview."
target = SubResource("ChoiceTarget")
completion_conditions = Array[ExtResource("1_wxwvi")]([SubResource("Selected")])
entry_actions = Array[ExtResource("4_avub8")]([SubResource("SelectOffers")])
input_mode = 2
message_position = 3

[sub_resource type="Resource" id="PlaceTarget"]
script = ExtResource("3")
