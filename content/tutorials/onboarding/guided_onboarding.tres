[sub_resource type="Resource" id="BoardTarget"]
script = ExtResource("3")
target_key = 2
padding = 6.0

[sub_resource type="Resource" id="BoardStep"]
script = ExtResource("2")
title = "The combat grid"
body = "Place Blocks anywhere they fit. They do not fall. Fill a row or column to clear it."
target = SubResource("BoardTarget")
input_mode = 1
message_position = 3
wait_for_player_confirmation = true

[sub_resource type="Resource" id="Selected"]
script = ExtResource("4")
choice_index = 0

[sub_resource type="Resource" id="SelectOffers"]
