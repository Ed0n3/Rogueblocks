[sub_resource type="Resource" id="EnemyTarget"]
script = ExtResource("3")
target_key = 4
padding = 5.0

[sub_resource type="Resource" id="DamageStep"]
script = ExtResource("2")
step_type = 4
title = "Clears strike the enemy"
body = "Every line clear deals damage. Larger clears, cross clears, and combos hit harder."
target = SubResource("EnemyTarget")
input_mode = 1
message_position = 3
wait_for_player_confirmation = true

[sub_resource type="Resource" id="IntentTarget"]
script = ExtResource("3")
target_key = 6
padding = 5.0

[sub_resource type="Resource" id="IntentStep"]
script = ExtResource("2")
title = "Read the enemy intent"
body = "Intent shows the enemy's next move, possible damage, and how many placements remain."
target = SubResource("IntentTarget")
input_mode = 1
message_position = 3
wait_for_player_confirmation = true

[sub_resource type="Resource" id="SummaryStep"]
script = ExtResource("2")
step_type = 12
title = "Ready for a run"
body = "Draw, choose, rotate, place, and clear Blocks. Watch enemy intent. More tips appear when you meet new systems."
input_mode = 1
message_position = 2
wait_for_player_confirmation = true

[resource]
script = ExtResource("1")
display_name = "Selecting, Placing, and Combat"
description = "Learn the core combat controls."
priority = 60
repeat_policy = 5
steps = Array[ExtResource("2")]([SubResource("BoardStep"), SubResource("ChoiceStep"), SubResource("PlaceStep"), SubResource("RotateStep"), SubResource("ClearStep"), SubResource("DamageStep"), SubResource("IntentStep"), SubResource("SummaryStep")])
blocks_gameplay = true
mark_complete_on_skip = true
tags = Array[StringName]([&"guided", &"sandbox"])
