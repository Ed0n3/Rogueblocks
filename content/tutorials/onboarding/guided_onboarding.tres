step_type = 7
title = "Place freely"
body = "Move the preview anywhere on the highlighted board, then tap Place."
target = SubResource("BoardTarget")
additional_input_targets = Array[ExtResource("3")]([SubResource("PlaceTarget")])
completion_conditions = Array[ExtResource("1_wxwvi")]([SubResource("Placed")])
