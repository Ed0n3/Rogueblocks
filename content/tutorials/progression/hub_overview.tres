[sub_resource type="Resource" id="UpgradeStep"]
script = ExtResource("2")
title = "Invest Fragments permanently"
body = "Fragments persist between runs. Open the Upgrade Matrix to buy Blocks, place them in colored areas, and activate permanent upgrade levels."
target = SubResource("UpgradeTarget")
input_mode = 1
message_position = 3
wait_for_player_confirmation = true

