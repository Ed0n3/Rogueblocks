[sub_resource type="Resource" id="ExpeditionStep"]
script = ExtResource("2")
title = "Start or continue an expedition"
body = "Choose a difficulty before starting a New Run. Continue Run resumes the current route, while Resume Fight returns to an interrupted encounter."
target = SubResource("ExpeditionTarget")
input_mode = 1
message_position = 4
wait_for_player_confirmation = true

