[sub_resource type="Resource" id="Intro"]
script = ExtResource("2")
title = "Build this run's Block pile"
body = "Your collection holds every unlocked Block. This run seed chooses twelve piece candidates, including duplicate shapes. Pick eight to build your starting Block pile."
