	SHOP_SCREEN_OPENED,
	STATUS_APPLIED,
	HAND_DRAWN,
	DRAW_PILE_CHANGED,
	DISCARD_PILE_CHANGED,
}

static func from_legacy(reference: StringName) -> Value:
	var normalized: String = String(reference).to_upper()
	var keys: Array = Value.keys()
	var index: int = keys.find(normalized)
	return index as Value if index >= 0 else Value.NONE
