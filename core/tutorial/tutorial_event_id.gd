	PIECE_CHOICES_GENERATED,
	PIECE_DRAFT_CONFIRMED,
	PIECE_DRAFT_OPENED,
	PIECE_PLACED,
	PIECE_ROTATED,
	PIECE_SELECTED,
	PLACEMENT_PREVIEW_CHANGED,
	PLAYER_DAMAGED,
	PROGRESSION_HUB_OPENED,
	RELIC_OBTAINED,
	REWARD_SCREEN_OPENED,
	ROUTE_NODE_SELECTED,
