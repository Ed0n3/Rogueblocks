	BLOCKERS_PLACED,
	BONUS_BLOCK_ACQUIRED,
	BONUS_BLOCK_INVENTORY_VISIBLE,
	COUNTER_COMPLETED,
	COUNTER_FAILED,
	COUNTER_PROGRESSED,
	COUNTER_STARTED,
	CROSS_CLEAR_COMPLETED,
	DAMAGE_OVER_TIME_APPLIED,
	DISCARD_PIECE_ADDED,
	ENCOUNTER_STARTED,
	ENEMY_ATTACKED,
	ENEMY_DAMAGED,
	ENEMY_HEALED,
	ENEMY_INTENT_CHANGED,
	ENEMY_SHIELD_GAINED,
	FORCED_PIECE_STARTED,
	INVALID_PLACEMENT_ATTEMPTED,
	ITEM_ACQUIRED,
	ITEM_INVENTORY_VISIBLE,
	ITEM_USED,
	LINES_CLEARED,
	PERFECT_CLEAR_COMPLETED,
