class_name UpgradeMatrixEconomyConfiguration
extends Resource

## Number of pieces generated by compatibility Matrix offers.
@export_range(1, 20, 1) var shop_offer_count: int = 3
## Fragment cost of the first occupied cell in a Block.
@export_range(0, 10000, 1) var first_cell_fragment_cost: int = 4
## Fragment cost of the second occupied cell before reductions.
@export_range(0, 10000, 1) var additional_cell_start_fragment_cost: int = 3
## Cost reduction applied for each further occupied cell.
@export_range(0, 10000, 1) var additional_cell_fragment_cost_reduction: int = 1
## Minimum Fragment cost of each additional occupied cell.
@export_range(0, 10000, 1) var minimum_additional_cell_fragment_cost: int = 2
## Minimum total Fragment price after discounts.
@export_range(1, 10000, 1) var minimum_fragment_cost: int = 1
## Largest discount accepted by Matrix purchase validation.
@export_range(0.0, 0.95, 0.01) var maximum_shop_discount: float = 0.25

